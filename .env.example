# Root .env for `docker-compose.yml` (Postgres/MinIO/MLflow) and the
# Makefile's `check-env` guard (`make up`/`make dev-all` both require this
# file to exist, even if every value below is left at its default).
#
# Every value here matches docker-compose.yml's own `${VAR:-default}`
# fallback exactly, so `cp .env.example .env` with no edits is enough for
# local dev -- docker-compose already runs fine with these defaults even
# without a .env at all; this file exists so the Makefile's guard (and
# anyone who wants non-default local values) has something real to work
# from. Per-service secrets (external API keys, R2 credentials, etc.) live
# in each service's own .env -- see services/*/.env.example -- not here.

# Postgres (docker-compose.yml's `postgres` service -- MLflow's own
# backend store locally, matching services/waerehouse's dbt profile
# defaults for POSTGRES_USER/POSTGRES_DB in `dev` target).
POSTGRES_DB=ecolens
POSTGRES_USER=ecolens
POSTGRES_PASSWORD=ecolens
# 5433, not Postgres's real default 5432 -- docker-compose.yml's own
# fallback IS 5432, but a real, common local-dev conflict (confirmed
# live 2026-08-19: a non-Docker Postgres already listening on 5432,
# `docker compose up` failing with "address already in use") makes 5433
# the better zero-edits-needed default here. Only the *host* port
# changes -- containers still talk to each other over 5432 internally.
POSTGRES_HOST_PORT=5433

# Same reasoning, same day -- MLflow's container port stays 5000 (other
# containers reach it at http://mlflow:5000 over the compose network
# regardless of this value), but macOS's built-in AirPlay Receiver
# listens on host port 5000 by default, so mapping the *host* side to
# 5000 fails with the same "address already in use" error just about
# every real Mac hits. 5001 avoids it with zero edits needed.
MLFLOW_HOST_PORT=5001

# MinIO (S3-compatible object storage docker-compose.yml runs locally,
# standing in for R2/S3 in production) -- MLFLOW_S3_ENDPOINT_URL points
# MLflow's artifact store at it.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RAW=ecolens
S3_BUCKET_MODELS=ecolens
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
