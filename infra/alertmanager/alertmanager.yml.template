# Slack receiver for the alerts in infra/prometheus/recording_rules.yml
# (task.md's monitoring checklist: "Alertmanager → Slack on status='failed'
# rows in meta._ingest_log" -- implemented here as the broader
# IngestSourceStale/IngestSuccessRateLow/CircuitBreakerOpen alert set,
# which subsumes plain ingest failures rather than a narrower rule that
# only looks at individual failed rows).
#
# `.template` because Alertmanager's config parser does NOT interpolate
# `${VAR}` itself (unlike docker-compose's own YAML) -- the
# `alertmanager` service's command in docker-compose.yml runs this
# through `envsubst` into a real config file before starting the binary.
# SLACK_WEBHOOK_URL must be set (docker-compose.yml's `env_file: .env`)
# for the Slack route to actually deliver -- with it unset/empty,
# Alertmanager still runs and evaluates routing, it just has nowhere to
# send `slack-notifications` to. See
# https://api.slack.com/messaging/webhooks for how to mint one.
global:
  resolve_timeout: 5m
  slack_api_url: "${SLACK_WEBHOOK_URL}"

route:
  receiver: slack-notifications
  group_by: ["alertname", "source"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: slack-notifications
    slack_configs:
      - channel: "#ecolens-alerts"
        send_resolved: true
        title: '{{ .CommonAnnotations.summary }}'
        text: '{{ .CommonAnnotations.description }}'
