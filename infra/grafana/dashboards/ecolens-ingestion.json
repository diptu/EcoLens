{
  "title": "ecoLens — Ingestion",
  "uid": "ecolens-ingestion",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "tags": ["ecolens", "ingestion"],
  "panels": [
    {
      "id": 1,
      "title": "Ingest success rate by source (24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ecolens:ingest_success_rate_24h",
          "legendFormat": "{{ source }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Circuit breaker state by source",
      "description": "0 = closed, 1 = half_open, 2 = open",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "closed", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "half_open", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "open", "color": "red" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ecolens_circuit_breaker_state",
          "legendFormat": "{{ source }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Seconds since last successful ingest",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 900 },
              { "color": "red", "value": 1800 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ecolens:ingest_seconds_since_last_success",
          "legendFormat": "{{ source }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ingest runs by outcome (rate, 5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(ecolens_ingest_runs_total[5m])) by (source, outcome)",
          "legendFormat": "{{ source }} — {{ outcome }}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  }
}
