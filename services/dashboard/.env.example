# services/dashboard's own `.env.local` (gitignored) -- copy this file
# to `.env.local` (Next.js's own convention, not `.env`) and fill in
# real values. All three have sensible localhost defaults in
# `src/lib/env.ts` matching `make dev`'s own documented port map, so
# this file is only needed to point the dashboard at services running
# somewhere other than this same machine.
#
# `NEXT_PUBLIC_*` is required -- Next.js only inlines env vars with this
# exact prefix into the browser bundle at build time; anything else is
# server-side-only and invisible to this dashboard's client components
# (every fetch in `src/lib/*.ts` runs in the browser, not on a Next.js
# server).

# services/forecast-api (port 8002) -- carbon/emissions/forecast reads.
NEXT_PUBLIC_FORECAST_API_URL=http://localhost:8002/v1

# services/data-pipeline (port 8001) -- data-sources/ingestion/model-
# training/data-quality reads + triggers.
NEXT_PUBLIC_DATA_PIPELINE_API_URL=http://localhost:8001/v1

# IAM session-auth service (port 8000) -- NOT currently a real running
# service (`services/iam` was scaffolded then deleted, see root
# TODO.md's Known Gaps section); this default resolves to nothing today.
# Set this once/if a real IAM service exists to deploy independently.
NEXT_PUBLIC_IAM_API_URL=http://localhost:8000/api/v1
