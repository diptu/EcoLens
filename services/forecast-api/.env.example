# services/forecast-api's own `.env` (gitignored) -- copy this file to
# `.env` and fill in real values. `Settings` (app/core/config.py)
# deliberately mirrors data-pipeline's env var names for the infra both
# services share, so one real `.env` (with real credentials) can be
# copied to both services' directories unchanged.

# PostgreSQL 16 + TimescaleDB -- same warehouse data-pipeline writes to.
# Required -- no working default outside this repo's own docker-compose
# `postgres` service.
DATABASE_URL=postgresql://user:password@host:5432/ecolens

# Separate Postgres instance (2026-08-12) for the real "logger" table
# this service writes (`meta._training_log` only -- write via
# `log_training_start`/`log_training_finish`, read via
# `list_training_runs`) -- same split `services/ingestion`/`services/
# waerehouse` use for their own no-dbt-dependency audit-log tables, for
# the same reason. Optional -- falls back to DATABASE_URL when unset.
# **`meta.anomalies` reads here deliberately stay on DATABASE_URL, not
# here** -- real correction the same day this was introduced: `meta.
# anomalies` is a live dbt *source* feeding the dashboard's
# anomaly-detection overview chart, and dbt's own connection profile has
# no knowledge of `LOG_DB_URL` at all. See `app/service/model/actions.py`'s
# own module docstring for the fuller story. Set the identical value
# across all three services once deployed independently.
# LOG_DB_URL=postgresql://user:password@log-host:5432/ecolens_logs

# MLflow tracking server (README.md § MLflow: "forecast-api hot-reloads
# [the Production model] on the next request -- just a watch on the
# MLflow registry"). Must point at the SAME MLflow server data-pipeline
# registers/promotes model versions to, or this service will never see a
# newly-promoted version. `docker-compose up mlflow` serves this at
# http://localhost:5000 on the host, or http://mlflow:5000 from inside
# another compose service. Port 5000 collides with macOS's AirPlay
# Receiver if you're running MLflow as a bare local process instead of
# via compose -- that shows up as an unexplained 403 on every MLflow API
# call, not a connection error.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_REGISTRY_MODEL_NAME=lstm_demand

# RabbitMQ -- required for `train-worker` (`app.service.training_worker`,
# the `ecolens-forecast train-worker` CLI/docker-compose service) to
# receive training-trigger events at all; the bare FastAPI app itself
# only needs this to *publish* a manual `POST /v1/model/train` trigger.
# Real gap this fixes (2026-08-12): this var was previously undocumented
# here even though `app/core/config.py` has read it all along -- nothing
# stopped it working via `docker-compose.yml`'s shared `.env`, but a
# service deployed independently (its own machine/Railway project, no
# shared `.env` file) had no visible way to know it needed setting.
# Once ingestion/warehouse/forecast-api are independent services, this
# must point at the SAME real broker instance all three use -- there's
# no discovery mechanism, just this URL matching.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── Training-trigger topology (consume side) ────────────────────────

# `services/waerehouse`'s `dbt.training_trigger.publish_training_trigger`
# is the publisher on the other end. **All five of these must be set to
# identical values on both services** once deployed independently (see
# `services/waerehouse/.env.example`'s matching block for the full
# reasoning) -- both sides declare this exact same exchange/queue/DLX
# topology on connect, so a mismatch here raises a real
# `PRECONDITION_FAILED` channel error on whichever side connects second,
# not a silent miss.
# RABBITMQ_TRAINING_EXCHANGE=forecasting.training
# RABBITMQ_TRAINING_ROUTING_KEY=training.trigger
# RABBITMQ_TRAINING_TRIGGER_QUEUE=forecasting.training.trigger
# RABBITMQ_TRAINING_DLX=forecasting.training.dlx
# RABBITMQ_TRAINING_TRIGGER_DLQ=forecasting.training.trigger.dlq
