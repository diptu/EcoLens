# services/forecast-api's own `.env` (gitignored) -- copy this file to
# `.env` and fill in real values. `Settings` (app/core/config.py)
# deliberately mirrors data-pipeline's env var names for the infra both
# services share, so one real `.env` (with real credentials) can be
# copied to both services' directories unchanged.

# PostgreSQL 16 + TimescaleDB -- same warehouse data-pipeline writes to.
# Required -- no working default outside this repo's own docker-compose
# `postgres` service.
DATABASE_URL=postgresql://user:password@host:5432/ecolens

# MLflow tracking server (README.md § MLflow: "forecast-api hot-reloads
# [the Production model] on the next request -- just a watch on the
# MLflow registry"). Must point at the SAME MLflow server data-pipeline
# registers/promotes model versions to, or this service will never see a
# newly-promoted version. `docker-compose up mlflow` serves this at
# http://localhost:5000 on the host, or http://mlflow:5000 from inside
# another compose service. Port 5000 collides with macOS's AirPlay
# Receiver if you're running MLflow as a bare local process instead of
# via compose -- that shows up as an unexplained 403 on every MLflow API
# call, not a connection error.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_REGISTRY_MODEL_NAME=lstm_demand
