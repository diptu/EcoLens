# Copy to `.env` before `docker compose up` -- see README.md's "Running
# this stack in production" section. `.env` is gitignored; nothing
# sensitive is committed here.

# ── Required secrets ─────────────────────────────────────────────────────
# Grafana's initial admin password. Only seeds a *fresh* `grafana_data`
# volume -- if you're deploying against a volume that was ever
# initialized before, run
#   docker exec observility-grafana-1 grafana-cli admin reset-admin-password <password>
# once instead (README.md's note applies here verbatim).
GRAFANA_ADMIN_PASSWORD=

# Alertmanager's generic webhook receiver destination -- a Slack incoming
# webhook, PagerDuty Events API v2 webhook, or any endpoint that accepts
# Alertmanager's own JSON payload (https://prometheus.io/docs/alerting/latest/configuration/#webhook_config).
# docker compose refuses to start alertmanager-config without this set
# (see alertmanager/alertmanager.yml.template).
ALERTMANAGER_WEBHOOK_URL=

# ── Retention (tune per environment; see TODO.md's Production Hardening
#    section for current defaults and the tradeoffs of raising these) ────
PROMETHEUS_RETENTION=15d
LOKI_RETENTION_PERIOD=168h
TEMPO_RETENTION=72h

# ── Business-service scrape targets ──────────────────────────────────────
# `host:port` Prometheus scrapes `GET /metrics` from. Defaults below
# match the root `../../docker-compose.yml` project's own Docker
# service names/ports -- correct as-is when every service (including
# this observability stack) shares that one Docker network on one
# machine, which is the common case. Deploying a service to a different
# machine? Point its target at wherever that service is actually
# reachable from (a real routable host:port, a Tailscale/VPN hostname,
# internal DNS, etc.) instead -- see `prometheus/prometheus.yml.template`'s
# own header comment.
DATA_PIPELINE_TARGET=data-pipeline:8001
INGESTION_TARGET=ingestion:8003
WAREHOUSE_TARGET=warehouse:8004
FORECAST_API_TARGET=api:8000

# Note: the `environment=` label from README.md's "Observability
# Contract" is set as a static value directly in
# prometheus/prometheus.yml.template (`external_labels.environment`),
# not via an env var here -- see that file's own header comment for
# why. Edit it directly for a non-dev deployment of this stack.
