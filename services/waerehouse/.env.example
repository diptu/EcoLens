# services/waerehouse's own `.env` (gitignored) -- copy this file to
# `.env` and fill in real values. `Settings` (app/core/config.py) has
# sensible localhost defaults for everything below except `DATABASE_URL`,
# so a local `docker-compose up` stack mostly works without a `.env` at
# all -- this file exists for the values worth being explicit about, not
# an exhaustive dump of every `Settings` field.

# PostgreSQL 16 + TimescaleDB -- the same warehouse `services/data-pipeline`
# writes to. Required -- no working default outside this repo's own
# docker-compose `postgres` service.
DATABASE_URL=postgresql://user:password@host:5432/ecolens

# Second physical database (root TODO.md's "save raw and raw.marts in
# seperate database"), a genuinely separate project/host from
# DATABASE_URL above -- not a second schema on the same one.
# `retention/marts_archive.py` archives raw_marts.* rows older than
# MARTS_LOCAL_RETENTION_DAYS here before pruning them from the primary.
# Optional -- unset means the archive job cleanly no-ops (logged
# "skipped", not a failure); everything else in this service works
# without it.
# RAW_MARTS_DATABASE_URL=postgresql://user:password@host2:5432/ecolens
# MARTS_LOCAL_RETENTION_DAYS=60

# RabbitMQ -- consume-only, reads `ecolens.landing` (the same queue name
# `services/ingestion`'s `publish_landed_event` writes to -- the name
# has to match exactly, it's the one real coupling point between the two
# services). Required for anything beyond the bare FastAPI control
# plane -- no working default outside this repo's own docker-compose
# `rabbitmq` service.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# DuckDB staging directory -- must resolve to the SAME physical file
# `services/ingestion` writes into when both run on one machine sharing
# a Docker volume (their defaults already match for exactly this
# reason -- don't change one without the other). When this service runs
# on a DIFFERENT machine than `services/ingestion`, that shared-volume
# trick doesn't apply at all -- this service automatically falls back to
# downloading the run's snapshot from object storage instead
# (`app.db.duckdb_client.read_run_with_fallback`), which is why the R2
# block below becomes REQUIRED (not just a nice-to-have) in a
# cross-machine deployment: local MinIO on this machine would be a
# different, empty bucket from whatever `services/ingestion` uploaded
# to on its own machine.
# DUCKDB_STAGING_DIR=./data/staging

# Cloudflare R2 (S3-compatible object storage) -- same account/bucket
# `services/ingestion`'s own `object_storage.py` uses. All four required
# together for `object_storage_configured` to be true -- with any unset,
# this falls back to local MinIO, which is only correct when this
# service and `services/ingestion` share the same Docker host/volume
# (see the DUCKDB_STAGING_DIR note above for why that matters here
# specifically, more than it would for a service with no shared-volume
# handoff at all).
CLOUDFLARESTORAGE_ACCOUNT_ID=
CLOUDFLARESTORAGE_S3_API=
CLOUDFLARESTORAGE_ACCESS_KEY_ID=
CLOUDFLARESTORAGE_SECRET_ACCESS_KEY=

# This service's own FastAPI control plane port. Rarely needs changing
# -- override only if 8004 collides with something else on the host.
# API_PORT=8004
