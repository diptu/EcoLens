# services/waerehouse's own `.env` (gitignored) -- copy this file to
# `.env` and fill in real values. `Settings` (app/core/config.py) has
# sensible localhost defaults for everything below except `DATABASE_URL`,
# so a local `docker-compose up` stack mostly works without a `.env` at
# all -- this file exists for the values worth being explicit about, not
# an exhaustive dump of every `Settings` field.

# PostgreSQL 16 + TimescaleDB -- the same warehouse `services/data-pipeline`
# writes to. Required -- no working default outside this repo's own
# docker-compose `postgres` service.
DATABASE_URL=postgresql://user:password@host:5432/ecolens

# Second physical database (root TODO.md's "save raw and raw.marts in
# seperate database"), a genuinely separate project/host from
# DATABASE_URL above -- not a second schema on the same one.
# `retention/marts_archive.py` archives raw_marts.* rows older than
# MARTS_LOCAL_RETENTION_DAYS here before pruning them from the primary.
# Optional -- unset means the archive job cleanly no-ops (logged
# "skipped", not a failure); everything else in this service works
# without it.
# RAW_MARTS_DATABASE_URL=postgresql://user:password@host2:5432/ecolens
# MARTS_LOCAL_RETENTION_DAYS=60

# Third, separate Postgres instance (2026-08-12) for the real "logger"
# tables this service writes that dbt never needs to read
# (`meta._dbt_build_log`, `meta._retention_log`, `meta._marts_archive_
# log`) -- an explicit split from DATABASE_URL, same reasoning as
# RAW_MARTS_DATABASE_URL above but for audit/history tables instead of
# `raw_marts.*`. Optional -- falls back to DATABASE_URL when unset.
# **`meta._ingest_log` (status updates) and `meta.anomalies` (reads)
# deliberately stay on DATABASE_URL, not here** -- real correction the
# same day this was introduced: `meta.anomalies` is a live dbt *source*
# (`dbt/ecolens/models/staging/stg_anomalies.sql`, feeding the
# dashboard's anomaly-detection overview chart), and dbt's own
# connection profile has no knowledge of `LOG_DB_URL` at all -- moving
# that table here made the chart permanently stale the moment it
# happened, confirmed live. `meta._ingest_log` stayed with it only
# because of a real foreign key, not its own dbt dependency. See
# `app/consumers/landed_events.py`'s own module docstring for the fuller
# story. **Must be the identical value `services/ingestion` and
# `services/forecast-api` use** once all three are deployed independently.
# LOG_DB_URL=postgresql://user:password@log-host:5432/ecolens_logs

# RabbitMQ -- required for anything beyond the bare FastAPI control
# plane -- no working default outside this repo's own docker-compose
# `rabbitmq` service. Once ingestion/warehouse/forecast-api are deployed
# as independent services (each its own machine/Railway project), this
# must point at the SAME real broker instance all three are configured
# against -- there's no discovery mechanism, just this URL matching.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── Landed-event queue (consume side) ───────────────────────────────
# Reads `ecolens.landing` by default -- the same queue name
# `services/ingestion`'s `publish_landed_event` writes to (its own
# `RABBITMQ_LANDING_QUEUE`, see that service's `.env.example`) -- the
# name has to match exactly, it's the one real coupling point between
# the two services. A mismatch doesn't error on either side; it just
# means this service silently never receives ingestion's events.
# RABBITMQ_LANDING_QUEUE=ecolens.landing

# This service's own application-level dead-letter exchange/queue for
# landed events that fail to sync (`app/db/rabbitmq.py`'s module
# docstring explains why this is app-level, not a native queue-argument
# DLX, on `ecolens.landing` itself). Warehouse-only -- `services/
# ingestion` has no equivalent setting and doesn't need to match these.
# RABBITMQ_LANDING_DLX=ecolens.landing.dlx
# RABBITMQ_LANDING_DLQ=ecolens.landing.dlq

# ── Training-trigger topology (publish side) ────────────────────────
# Published once a real `dbt build` succeeds
# (`app.dbt.training_trigger.publish_training_trigger`) --
# `services/forecast-api`'s `train-worker` is the consumer on the other
# end. **All five of these must be set to identical values on both
# services** once deployed independently (see `services/forecast-api/
# .env.example`'s matching block) -- both sides declare this exact same
# exchange/queue/DLX topology on connect (whichever side connects
# first actually creates it), so a mismatch here raises a real
# `PRECONDITION_FAILED` channel error on whichever side connects
# second, not a silent miss like the landed-event queue above.
# RABBITMQ_TRAINING_EXCHANGE=forecasting.training
# RABBITMQ_TRAINING_ROUTING_KEY=training.trigger
# RABBITMQ_TRAINING_TRIGGER_QUEUE=forecasting.training.trigger
# RABBITMQ_TRAINING_DLX=forecasting.training.dlx
# RABBITMQ_TRAINING_TRIGGER_DLQ=forecasting.training.trigger.dlq

# DuckDB staging directory -- must resolve to the SAME physical file
# `services/ingestion` writes into when both run on one machine sharing
# a Docker volume (their defaults already match for exactly this
# reason -- don't change one without the other). When this service runs
# on a DIFFERENT machine than `services/ingestion`, that shared-volume
# trick doesn't apply at all -- this service automatically falls back to
# downloading the run's snapshot from object storage instead
# (`app.db.duckdb_client.read_run_with_fallback`), which is why the R2
# block below becomes REQUIRED (not just a nice-to-have) in a
# cross-machine deployment: local MinIO on this machine would be a
# different, empty bucket from whatever `services/ingestion` uploaded
# to on its own machine.
# DUCKDB_STAGING_DIR=./data/staging

# Cloudflare R2 (S3-compatible object storage) -- same account/bucket
# `services/ingestion`'s own `object_storage.py` uses. All four required
# together for `object_storage_configured` to be true -- with any unset,
# this falls back to local MinIO, which is only correct when this
# service and `services/ingestion` share the same Docker host/volume
# (see the DUCKDB_STAGING_DIR note above for why that matters here
# specifically, more than it would for a service with no shared-volume
# handoff at all).
CLOUDFLARESTORAGE_ACCOUNT_ID=
CLOUDFLARESTORAGE_S3_API=
CLOUDFLARESTORAGE_ACCESS_KEY_ID=
CLOUDFLARESTORAGE_SECRET_ACCESS_KEY=

# This service's own FastAPI control plane port. Rarely needs changing
# -- override only if 8004 collides with something else on the host.
# API_PORT=8004
